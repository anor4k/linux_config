[Unit]
Description=Move Steam Big Picture to the LG TV and revert on exit
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Inherits DISPLAY/WAYLAND_DISPLAY/DBUS/XAUTHORITY from the user session,
# but set the essentials explicitly so it works even if imported late.
Environment=DISPLAY=:1
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=%h/.local/bin/steam-tv-display watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
