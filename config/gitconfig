[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
    history = log --pretty=format:\"%h %s\" --graph
    cleanup = !git branch --merged | grep -vE '^[ *+]*(main|master|production|dev)$' | xargs -r git branch -d
    zip = "!git archive HEAD -o ${PWD##*/}.zip"
	squash = "!f(){ git reset --soft \"$1\" && git commit; }; f"

[fetch]
    prune = true

[core]
    quotepath = off
    pager = delta
    autocrlf = input

[delta]
    navigate = true

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[color]
	ui = auto

[advice]
	skippedCherryPicks = false

[rerere]
    enabled = true

[includeIf "gitdir:~/yofi/"]
    path = "~/yofi/.gitconfig"
