# Re-run the IRQ isolation whenever the Audient EVO4 is (re)connected, so it
# follows the device to whichever xHCI controller it lands on.
# Install: /etc/udev/rules.d/60-evo4-irq-isolate.rules
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="2708", ATTR{idProduct}=="0006", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="evo4-irq-isolate.service"
